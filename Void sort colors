    int zero = 0, one = 0, two = 0;

        // Count 0s, 1s, and 2s
        for (int num : nums) {
            if (num == 0) {
                zero++;
            } else if (num == 1) {
                one++;
            } else {
                two++;
            }
        }

        // Fill the array with 0s
        int i = 0;
        while (zero > 0) {
            nums[i++] = 0;
            zero--;
        }

        // Fill the array with 1s
        while (one > 0) {
            nums[i++] = 1;
            one--;
        }

        // Fill the array with 2s
        while (two > 0) {
            nums[i++] = 2;
            two--;
        }
    }
}
